# ─── Environment variables ─────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000

# Provider mode: "mock" uses seed data, "real" calls external APIs
PROVIDER_MODE=mock

# Set DB_ENABLED=false to run in pure mock mode without Docker/PostgreSQL.
# Set DB_ENABLED=true once PostgreSQL is started.
DB_ENABLED=false

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=safar
DATABASE_PASSWORD=safar
DATABASE_NAME=safar
DATABASE_URL=postgresql://safar:safar@localhost:5432/safar

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Google APIs (leave blank until keys are obtained) ────────────────────────
# Server-side only. Never put these in the Flutter app.
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_WEATHER_API_KEY=

# ─── Claude AI (Phase 5 only — leave blank for now) ──────────────────────────
CLAUDE_API_KEY=

# ─── AWS S3 (needed for photo uploads — leave blank for now) ─────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Flutter app (add to apps/mobile/.env) ────────────────────────────────────
# Only the backend base URL goes here — no API keys in the app.
BACKEND_BASE_URL=http://10.0.2.2:3000
